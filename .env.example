# Existing Supabase project
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Backend-only secret. Never expose this in frontend code.
SUPABASE_SERVICE_ROLE_KEY=

# Existing model artifacts
FOOTBALL_MODEL_PATH=models/football_model.cbm
FOOTBALL_CALIBRATION_PATH=models/football_model_confidence.joblib
FOOTBALL_MODEL_VERSION=catboost-v1-existing
FOOTBALL_FEATURE_SCHEMA_VERSION=leakage-safe-v1

# API
FOVRA_CORS_ORIGINS=http://localhost:8000
FOVRA_TIMEZONE=Europe/Athens
